// Free-tier self-hosted sync service: D1 stores account metadata; SQLite Durable Objects store encrypted blobs.
// No R2 subscription, payment method, custom domain, or account-specific ID is required.
{
  "name": "beayy-sync-selfhosted",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "vars": { "OPEN_SIGNUP": "true" },
  "d1_databases": [
    { "binding": "DB", "database_name": "beayy-sync-selfhosted" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "BLOBS", "class_name": "BeayyBlobStore" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["BeayyBlobStore"] }
  ]
}
